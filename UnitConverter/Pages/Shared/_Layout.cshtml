<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UnitConverter</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UnitConverter.styles.css" asp-append-version="true" />
</head>

<body class="body-background-image bg-cover bg-center bg-fixed">
    <header class="mb-3 shadow-md opacity-95 fixed top-0 left-0 right-0 z-10">
        <nav class="bg-gray-300">
            <a class="text-2xl font-bold p-5 inline-block" asp-page="/Index">UnitConverter</a>
        </nav>
    </header>

    <main class="mt-40">
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
